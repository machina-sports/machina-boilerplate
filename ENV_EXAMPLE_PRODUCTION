# Production Environment Variables
# Create a .env.production file with these values before running docker build

# Client-side variables (Available in browser)
NEXT_PUBLIC_BRAND=default
NEXT_PUBLIC_APP_NAME="Machina Frontend"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

# Machina pod variables (server-side only)
MACHINA_API_URL=https://your-project.org.machina.gg
MACHINA_AGENT=machina-assistant-executor

# Set either a pod API key (sent as X-Api-Token) or a project token minted by
# `machina login` (sent as X-Project-Token).
MACHINA_API_KEY=
# MACHINA_PROJECT_TOKEN=
